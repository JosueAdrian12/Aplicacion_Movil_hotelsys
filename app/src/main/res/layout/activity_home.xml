<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="25dp"
    android:background="#15100F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎬 CINE ZONE"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="40dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una categoría de películas"
        android:textSize="18sp"
        android:textColor="#CFCFCF"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnJuego1"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="🎞️ PELÍCULAS DE ACCIÓN"
        android:textSize="17sp"/>

    <Button
        android:id="@+id/btnJuego2"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="👻 PELÍCULAS DE TERROR"
        android:textSize="17sp"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnJuego3"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="😂 PELÍCULAS DE COMEDIA"
        android:textSize="17sp"
        android:layout_marginTop="20dp"/>

</LinearLayout>
